package com.knot.provisioning.dto;

import java.io.Serializable;

/**
 * @author Laxmi_Viek
 *
 */


public class Activities implements Serializable {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	
	private Integer activityID;
	
	private Integer tenantID;

	private Integer partnerID;

	private String activityCode;
	
	private String activityName;

	private String activityDescription;

	private String activityArea;

	private String actionCode;

	private Integer activityAreaID;
	
	private Integer activityTypeID;
	
	private Integer activitySubTypeID;
	
	private Integer activityPriority;
	
	private String effectiveFrom;

	private String effectiveTo;

	private Integer retryCount;
	
	private Integer status;

	private String createdBy;

	private String createdIpAddr;

	private String createdOn;

	private String modifiedBy;

	private String modifiedIpAddr;

	private String modifiedOn;

	private String slaApplicable;
	
	private Integer slaElementID;
	
	private Integer escalationLevel;
	
	private Integer targetDuration;
	
	private String taskIndicator;
	
	public Activities() {
		
	}
	
	public Integer getActivityID() {
		return activityID;
	}

	public void setActivityID(Integer activityID) {
		this.activityID = activityID;
	}

	public Integer getTenantID() {
		return tenantID;
	}

	public void setTenantID(Integer tenantID) {
		this.tenantID = tenantID;
	}

	public Integer getPartnerID() {
		return partnerID;
	}

	public void setPartnerID(Integer partnerID) {
		this.partnerID = partnerID;
	}

	public String getActivityName() {
		return activityName;
	}

	public void setActivityName(String activityName) {
		this.activityName = activityName;
	}

	public String getActivityDesc() {
		return activityDescription;
	}

	public void setActivityDesc(String activityDesc) {
		this.activityDescription = activityDesc;
	}

	public String getActivityArea() {
		return activityArea;
	}

	public void setActivityArea(String activityArea) {
		this.activityArea = activityArea;
	}

	public String getActivityCode() {
		return activityCode;
	}

	public void setActivityCode(String activityCode) {
		this.activityCode = activityCode;
	}

	public Integer getActivityAreaID() {
		return activityAreaID;
	}

	public void setActivityAreaID(Integer activityAreaID) {
		this.activityAreaID = activityAreaID;
	}

	public Integer getActivityTypeID() {
		return activityTypeID;
	}

	public void setActivityTypeID(Integer activityTypeID) {
		this.activityTypeID = activityTypeID;
	}

	public Integer getActivitySubTypeID() {
		return activitySubTypeID;
	}

	public void setActivitySubTypeID(Integer activitySubTypeID) {
		this.activitySubTypeID = activitySubTypeID;
	}

	public Integer getActivityPriority() {
		return activityPriority;
	}

	public void setActivityPriority(Integer activityPriority) {
		this.activityPriority = activityPriority;
	}

	
	public Integer getRetryCount() {
		return retryCount;
	}

	public void setRetryCount(Integer retryCount) {
		this.retryCount = retryCount;
	}

	public Integer getStatus() {
		return status;
	}

	public void setStatus(Integer status) {
		this.status = status;
	}

	public String getCreatedBy() {
		return createdBy;
	}

	public void setCreatedBy(String createdBy) {
		this.createdBy = createdBy;
	}

	public String getCreatedIPAddr() {
		return createdIpAddr;
	}

	public void setCreatedIPAddr(String createdIPAddr) {
		this.createdIpAddr = createdIPAddr;
	}

	public String getModifiedBy() {
		return modifiedBy;
	}

	public void setModifiedBy(String modifiedBy) {
		this.modifiedBy = modifiedBy;
	}

	public String getModifiedIPAddr() {
		return modifiedIpAddr;
	}

	public void setModifiedIPAddr(String modifiedIPAddr) {
		this.modifiedIpAddr = modifiedIPAddr;
	}


