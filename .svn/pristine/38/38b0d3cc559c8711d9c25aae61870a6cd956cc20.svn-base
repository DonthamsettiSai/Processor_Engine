		return actionCode;
	}

	public void setActionCode(String actionCode) {
		this.actionCode = actionCode;
	}

	public String getSlaApplicable() {
		return slaApplicable;
	}

	public void setSlaApplicable(String slaApplicable) {
		this.slaApplicable = slaApplicable;
	}

	public Integer getSlaElementID() {
		return slaElementID;
	}

	public void setSlaElementID(Integer slaElementID) {
		this.slaElementID = slaElementID;
	}

	public String getActivityDescription() {
		return activityDescription;
	}

	public void setActivityDescription(String activityDescription) {
		this.activityDescription = activityDescription;
	}

	public String getCreatedIpAddr() {
		return createdIpAddr;
	}

	public void setCreatedIpAddr(String createdIpAddr) {
		this.createdIpAddr = createdIpAddr;
	}

	public String getModifiedIpAddr() {
		return modifiedIpAddr;
	}

	public void setModifiedIpAddr(String modifiedIpAddr) {
		this.modifiedIpAddr = modifiedIpAddr;
	}

