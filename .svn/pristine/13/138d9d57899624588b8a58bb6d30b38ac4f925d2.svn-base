package com.knot.provisioning.dto;

import java.io.Serializable;

/**@JsonIgnoreProperties(ignoreUnknown = true)*/
public class ServiceLvlDetailsDTO implements Serializable{

	/**
	 * @author Sai D
	 */
	private static final long serialVersionUID = 1L;

	private String reqDtlID;
	
	private String statusCode;
	
	private String statusMessage;
	
	private String workOrderID;

	private String svlan;

	private String cvlan;

	private String ipv4_address;
	
	private String subnet_mask_ipv4;
	
	private String subnet_mask_ipv6;
	
	private String ipv6_address;

	private String ont_port_instance;
	
	private String ont_end_points;
	
	private String ontSerialNumber;
	
	private String gateway_ipv6;
	
	private String gateway_ipv4;
	
	private String service_id;

	public String getGateway_ipv4() {
		return gateway_ipv4;
	}

	public void setGateway_ipv4(String gateway_ipv4) {
		this.gateway_ipv4 = gateway_ipv4;
	}

	
	public String getService_id() {
		return service_id;
	}

	public void setService_id(String service_id) {
		this.service_id = service_id;
	}

	public String getWorkOrderID() {
		return workOrderID;
	}

	public void setWorkOrderID(String workOrderID) {
		this.workOrderID = workOrderID;
	}

	public String getSvlan() {
		return svlan;
	}

	public void setSvlan(String svlan) {
		this.svlan = svlan;
	}

	public String getCvlan() {
		return cvlan;
	}

	public void setCvlan(String cvlan) {
		this.cvlan = cvlan;
	}

	public String getOnt_port_instance() {
		return ont_port_instance;
	}

	public void setOnt_port_instance(String ont_port_instance) {
		this.ont_port_instance = ont_port_instance;
	}

	public String getIpv4_address() {
		return ipv4_address;
	}

	public void setIpv4_address(String ipv4_address) {
		this.ipv4_address = ipv4_address;
	}

	public String getReqDtlID() {
		return reqDtlID;
	}

	public void setReqDtlID(String reqDtlID) {
		this.reqDtlID = reqDtlID;
	}

	public String getStatusCode() {
		return statusCode;
	}

	public void setStatusCode(String statusCode) {
		this.statusCode = statusCode;
	}

	public String getStatusMessage() {
		return statusMessage;
	}

	public void setStatusMessage(String statusMessage) {
		this.statusMessage = statusMessage;
	}

	public String getOnt_end_points() {
		return ont_end_points;
	}

	public void setOnt_end_points(String ont_end_points) {
		this.ont_end_points = ont_end_points;
	}

	public String getOntSerialNumber() {
		return ontSerialNumber;
	}

	public void setOntSerialNumber(String ontSerialNumber) {
		this.ontSerialNumber = ontSerialNumber;
	}
	
	public String getSubnet_mask_ipv4() {
		return subnet_mask_ipv4;
	}

	public void setSubnet_mask_ipv4(String subnet_mask_ipv4) {
		this.subnet_mask_ipv4 = subnet_mask_ipv4;
	}

	public String getSubnet_mask_ipv6() {
		return subnet_mask_ipv6;
	}

	public void setSubnet_mask_ipv6(String subnet_mask_ipv6) {
		this.subnet_mask_ipv6 = subnet_mask_ipv6;
	}

	public String getIpv6_address() {
		return ipv6_address;
	}

	public void setIpv6_address(String ipv6_address) {
		this.ipv6_address = ipv6_address;
	}

	public String getGateway_ipv6() {
		return gateway_ipv6;
	}

	public void setGateway_ipv6(String gateway_ipv6) {
		this.gateway_ipv6 = gateway_ipv6;
	}
	
}
