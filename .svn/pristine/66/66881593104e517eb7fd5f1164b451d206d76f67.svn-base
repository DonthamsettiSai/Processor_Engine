package com.knot.provisioning.dto;

import java.io.Serializable;

public class WFMDto implements Serializable{

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	
	private String jobOrderId; 
	
	private String atomicIdActivate;

	public String getJobOrderId() {
		return jobOrderId;
	}

	public void setJobOrderId(String jobOrderId) {
		this.jobOrderId = jobOrderId;
	}

	public String getAtomicIdActivate() {
		return atomicIdActivate;
	}

	public void setAtomicIdActivate(String atomicIdActivate) {
		this.atomicIdActivate = atomicIdActivate;
	} 
	

}
